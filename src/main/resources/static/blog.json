            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["友链"],
        "summary": "删除友链（需登录）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "friend_links 表的记录 ID" }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/about": {
      "get": {
        "tags": ["关于"],
        "summary": "获取关于页信息（时间线等）",
        "description": "返回关于页展示的成长时间线等信息。公开接口，无需登录；图标与配色由前端决定，后端只提供文本数据。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/AboutInfo" }
                      }
                    }
                  ]
                },
                "example": {
                  "code": 200,
                  "msg": "success",
                  "data": {
                    "timeline": [
                      { "year": "2025", "title": "开始写博客", "desc": "搭建了这个数字分身博客，记录学习与生活，分享技术文章与个人思考。" },
                      { "year": "2024", "title": "深入全栈开发", "desc": "掌握了 Vue 3、Spring Boot、Docker 等现代技术栈，开始独立完成完整项目。" }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "UUID Token"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "description": "通用响应壳，只含 code + msg；具体 data 类型由各接口通过 allOf 自行定义",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "msg": { "type": "string", "example": "success" }
        }
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "a1b2c3d4e5f6..." },
          "user": { "$ref": "#/components/schemas/UserInfo" }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "nickname": { "type": "string" },
          "avatar": { "type": "string", "nullable": true }
        }
      },
      "AiConfigSaveRequest": {
        "type": "object",
        "required": ["provider", "model", "apiKey"],
        "properties": {
          "provider": { "type": "string", "example": "openai" },
          "model": { "type": "string", "example": "gpt-3.5-turbo" },
          "apiKey": { "type": "string", "example": "sk-xxxxxxxxxxxxxxxx" }
        }
      },
      "AiConfigResponse": {
        "type": "object",
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "apiKey": {
            "type": "string",
            "description": "脱敏后的 Key，如 sk-...abcd",
            "example": "sk-...abcd"
          }
        }
      },
      "ArticlePage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArticleListItem" }
          },
          "total": { "type": "integer", "example": 50 },
          "page": { "type": "integer", "example": 1 },
          "size": { "type": "integer", "example": 10 }
        }
      },
      "ArticleListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "summary": { "type": "string" },
          "cover": { "type": "string", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ArticleDetail": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "content": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "prevArticle": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slug": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "nextArticle": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slug": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      },
      "GraphData": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GraphNode" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GraphLink" }
          }
        }
      },
      "GraphNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "group": { "type": "string" }
        }
      },
      "GraphLink": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      },
      "NotePage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Note" }
          },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "size": { "type": "integer" }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "likes": { "type": "integer" },
          "isLiked": { "type": "boolean" }
        }
      },
      "NoteCreate": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "maxLength": 280 }
        }
      },
      "LikeResult": {
        "type": "object",
        "properties": {
          "likes": { "type": "integer" },
          "isLiked": { "type": "boolean" }
        }
      },
      "NowStatus": {
        "type": "object",
        "properties": {
          "music": {
            "type": "object",
            "nullable": true,
            "properties": {
              "title": { "type": "string" },
              "artist": { "type": "string" },
              "cover": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "reading": {
            "type": "object",
            "nullable": true,
            "properties": {
              "title": { "type": "string" },
              "cover": { "type": "string" }
            }
          },
          "location": { "type": "string", "nullable": true }
        }
      },
      "AiSummary": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" }
        }
      },
      "AiChatResult": {
        "type": "object",
        "properties": {
          "reply": { "type": "string" }
        }
      },
      "LabTool": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "initialData": { "type": "object" }
        }
      },
      "AnimePage": {
        "type": "object",
        "properties": {
          "records": { "type": "array", "items": { "$ref": "#/components/schemas/AnimeListItem" } },
          "total": { "type": "integer", "example": 50 },
          "page": { "type": "integer", "example": 1 },
          "size": { "type": "integer", "example": 12 }
        }
      },
      "AnimeListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "titleJa": { "type": "string", "nullable": true },
          "cover": { "type": "string", "nullable": true },
          "summary": { "type": "string", "nullable": true },
          "type": { "type": "string", "nullable": true, "example": "TV" },
          "episodesTotal": { "type": "integer", "nullable": true },
          "season": { "type": "string", "nullable": true, "example": "2023秋" },
          "rating": { "type": "number", "nullable": true },
          "airDate": { "type": "string", "format": "date", "nullable": true },
          "productionStatus": { "type": "integer", "example": 1, "description": "0-未知,1-连载中,2-已完结" }
        }
      },
      "AnimeDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "titleJa": { "type": "string", "nullable": true },
          "cover": { "type": "string", "nullable": true },
          "summary": { "type": "string", "nullable": true },
          "type": { "type": "string", "nullable": true },
          "episodesTotal": { "type": "integer", "nullable": true },
          "season": { "type": "string", "nullable": true },
          "rating": { "type": "number", "nullable": true },
          "airDate": { "type": "string", "format": "date", "nullable": true },
          "productionStatus": { "type": "integer" },
          "userRecord": { "$ref": "#/components/schemas/UserAnimeRecord", "nullable": true, "description": "当前登录用户的追番记录，未登录时为 null" }
        }
      },
      "UserAnimeRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "user_animes 表主键" },
          "watchStatus": { "type": "integer", "example": 1, "description": "0-想看,1-在看,2-已看完,3-弃了" },
          "episodesWatched": { "type": "integer", "example": 18 },
          "rating": { "type": "number", "nullable": true, "example": 9.5 },
          "comment": { "type": "string", "nullable": true }
        }
      },
      "UserAnime": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "description": "user_animes 表主键" },
          "anime": { "$ref": "#/components/schemas/AnimeListItem", "description": "关联的番剧元数据" },
          "watchStatus": { "type": "integer", "example": 1 },
          "episodesWatched": { "type": "integer", "example": 18 },
          "rating": { "type": "number", "nullable": true, "example": 9.5 },
          "comment": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "UserAnimeSaveRequest": {
        "type": "object",
        "required": ["animeId", "watchStatus"],
        "properties": {
          "animeId": { "type": "integer", "description": "番剧 ID" },
          "watchStatus": { "type": "integer", "description": "0-想看,1-在看,2-已看完,3-弃了" },
          "episodesWatched": { "type": "integer", "default": 0 },
          "rating": { "type": "number", "nullable": true },
          "comment": { "type": "string", "nullable": true, "maxLength": 500 }
        }
      },
      "Footprint": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "city": { "type": "string", "example": "东京" },
          "country": { "type": "string", "nullable": true, "example": "日本" },
          "lat": { "type": "number", "format": "double", "example": 35.6762 },
          "lng": { "type": "number", "format": "double", "example": 139.6503 },
          "date": { "type": "string", "format": "date", "nullable": true, "description": "到访日期" },
          "note": { "type": "string", "nullable": true, "description": "游记/备注" },
          "photo": { "type": "string", "nullable": true, "description": "照片 URL" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FootprintSaveRequest": {
        "type": "object",
        "required": ["city", "lat", "lng"],
        "properties": {
          "id": { "type": "integer", "nullable": true, "description": "存在则更新该记录，缺省则新增" },
          "city": { "type": "string", "maxLength": 100 },
          "country": { "type": "string", "nullable": true, "maxLength": 100 },
          "lat": { "type": "number", "format": "double", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "format": "double", "minimum": -180, "maximum": 180 },
          "date": { "type": "string", "format": "date", "nullable": true },
          "note": { "type": "string", "nullable": true, "maxLength": 2000 },
          "photo": { "type": "string", "nullable": true, "maxLength": 500 }
        }
      },
      "FriendLink": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "example": "小明の博客" },
          "url": { "type": "string", "format": "uri", "example": "https://example.com" },
          "avatar": { "type": "string", "nullable": true, "description": "头像 URL" },
          "city": { "type": "string", "nullable": true, "example": "北京" },
          "lat": { "type": "number", "format": "double", "nullable": true, "example": 39.9042 },
          "lng": { "type": "number", "format": "double", "nullable": true, "example": 116.4074 },
          "description": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FriendLinkSaveRequest": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "id": { "type": "integer", "nullable": true, "description": "存在则更新该记录，缺省则新增" },
          "name": { "type": "string", "maxLength": 100 },
          "url": { "type": "string", "maxLength": 500 },
          "avatar": { "type": "string", "nullable": true, "maxLength": 500 },
          "city": { "type": "string", "nullable": true, "maxLength": 100 },
          "lat": { "type": "number", "format": "double", "nullable": true, "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "format": "double", "nullable": true, "minimum": -180, "maximum": 180 },
          "description": { "type": "string", "nullable": true, "maxLength": 500 }
        }
      },
      "AboutInfo": {
        "type": "object",
        "description": "关于页信息",
        "properties": {
          "timeline": {
            "type": "array",
            "description": "成长时间线，按时间倒序排列",
            "items": { "$ref": "#/components/schemas/TimelineItem" }
          }
        }
      },
      "TimelineItem": {
        "type": "object",
        "description": "时间线条目（图标与配色由前端决定，后端不返回）",
        "properties": {
          "year": { "type": "string", "example": "2025" },
          "title": { "type": "string", "example": "开始写博客" },
          "desc": { "type": "string", "example": "搭建了这个数字分身博客，记录学习与生活。" }
        }
      }
    }
  }
}
