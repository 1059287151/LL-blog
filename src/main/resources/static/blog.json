    "/animes": {
      "get": {
        "tags": ["番剧"],
        "summary": "获取番剧列表（分页、筛选）",
        "security": [],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 12 } },
          { "name": "season", "in": "query", "schema": { "type": "string" }, "description": "放送季度，如 2023秋" },
          { "name": "type", "in": "query", "schema": { "type": "string" }, "description": "类型：TV/剧场版/OVA" },
          { "name": "productionStatus", "in": "query", "schema": { "type": "integer" }, "description": "制作状态：1-连载中,2-已完结" },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/AnimePage" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/animes/{id}": {
      "get": {
        "tags": ["番剧"],
        "summary": "获取番剧详情",
        "security": [],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/AnimeDetail" } } }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/user/animes": {
      "get": {
        "tags": ["番剧"],
        "summary": "获取当前用户的追番列表（需登录）",
        "security": [{ "bearerAuth": [] }],
        "description": "返回用户追番记录，附带关联的番剧元数据。",
        "parameters": [
          { "name": "watchStatus", "in": "query", "schema": { "type": "integer" }, "description": "筛选观看状态：0-想看,1-在看,2-已看完,3-弃了" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/UserAnime" } } } }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["番剧"],
        "summary": "保存或更新追番记录（需登录）",
        "security": [{ "bearerAuth": [] }],
        "description": "同一用户+同一番剧只存在一条记录，重复提交会更新。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserAnimeSaveRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["番剧"],
        "summary": "删除追番记录（需登录）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "query", "schema": { "type": "integer" }, "description": "user_animes 表的记录 ID" }
        ],
        "responses": {
          "200": {
            "description": "删除成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
