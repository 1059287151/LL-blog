{
  "openapi": "3.0.3",
  "info": {
    "title": "LL-Blog API (Token + Redis)",
    "version": "2.0.0",
    "description": "基于随机 Token + Redis 的博客后端接口，认证方式为请求头 Authorization: Bearer <token>"
  },
  "servers": [
    { "url": "http://localhost:8080/api", "description": "本地开发" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LoginData" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "退出登录（需登录）",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "退出成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/user/me": {
      "get": {
        "tags": ["用户"],
        "summary": "获取当前用户信息（需登录）",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/UserInfo" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/articles": {
      "get": {
        "tags": ["文章"],
        "summary": "获取文章列表（分页、筛选）",
        "security": [],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/ArticlePage" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/articles/links": {
      "get": {
        "tags": ["文章"],
        "summary": "获取文章双链关系（知识图谱）",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/GraphData" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/articles/{slug}": {
      "get": {
        "tags": ["文章"],
        "summary": "获取文章详情",
        "security": [],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/ArticleDetail" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/notes": {
      "get": {
        "tags": ["短内容"],
        "summary": "获取短内容列表（分页）",
        "security": [],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/NotePage" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["短内容"],
        "summary": "发布短内容（需登录）",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NoteCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发布成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/Note" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/notes/{id}/like": {
      "post": {
        "tags": ["短内容"],
        "summary": "切换点赞状态（需登录）",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LikeResult" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/status/now": {
      "get": {
        "tags": ["状态"],
        "summary": "获取当前用户此刻状态（需登录）",
        "security": [{ "bearerAuth": [] }],
        "description": "通过请求头中的 Token 识别用户，返回该用户的状态。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/NowStatus" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["状态"],
        "summary": "更新当前用户此刻状态（需登录）",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NowStatus" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          }
        }
      }
    },
    "/ai/summary": {
      "post": {
        "tags": ["AI"],
        "summary": "获取文章 AI 摘要",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "slug": { "type": "string" } },
                "required": ["slug"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/AiSummary" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/ai/chat": {
      "post": {
        "tags": ["AI"],
        "summary": "与 AI 对话",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "message": { "type": "string" } },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/AiChatResult" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/lab/random": {
      "get": {
        "tags": ["实验室"],
        "summary": "随机获取一个实验小工具",
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/ApiResponse" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "$ref": "#/components/schemas/LabTool" }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "UUID Token"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "msg": { "type": "string", "example": "success" },
          "data": { "type": "object", "nullable": true }
        }
      },
      "LoginData": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "a1b2c3d4e5f6..." },
          "user": { "$ref": "#/components/schemas/UserInfo" }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "nickname": { "type": "string" },
          "avatar": { "type": "string", "nullable": true }
        }
      },
      "ArticlePage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ArticleListItem" }
          },
          "total": { "type": "integer", "example": 50 },
          "page": { "type": "integer", "example": 1 },
          "size": { "type": "integer", "example": 10 }
        }
      },
      "ArticleListItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "summary": { "type": "string" },
          "cover": { "type": "string", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ArticleDetail": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "slug": { "type": "string" },
          "content": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "prevArticle": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slug": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "nextArticle": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slug": { "type": "string" },
              "title": { "type": "string" }
            }
          }
        }
      },
      "GraphData": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GraphNode" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GraphLink" }
          }
        }
      },
      "GraphNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "group": { "type": "string" }
        }
      },
      "GraphLink": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" }
        }
      },
      "NotePage": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Note" }
          },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "size": { "type": "integer" }
        }
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "likes": { "type": "integer" },
          "isLiked": { "type": "boolean" }
        }
      },
      "NoteCreate": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string", "maxLength": 280 }
        }
      },
      "LikeResult": {
        "type": "object",
        "properties": {
          "likes": { "type": "integer" },
          "isLiked": { "type": "boolean" }
        }
      },
      "NowStatus": {
        "type": "object",
        "properties": {
          "music": {
            "type": "object",
            "nullable": true,
            "properties": {
              "title": { "type": "string" },
              "artist": { "type": "string" },
              "cover": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "reading": {
            "type": "object",
            "nullable": true,
            "properties": {
              "title": { "type": "string" },
              "cover": { "type": "string" }
            }
          },
          "location": { "type": "string", "nullable": true }
        }
      },
      "AiSummary": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" }
        }
      },
      "AiChatResult": {
        "type": "object",
        "properties": {
          "reply": { "type": "string" }
        }
      },
      "LabTool": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "initialData": { "type": "object" }
        }
      }
    }
  }
}
